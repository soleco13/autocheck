SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Cert renewal check twice daily; certbot itself only renews within its expiry window.
17 3,15 * * * root { cd /opt/autocheck && docker compose run --rm certbot renew --webroot -w /var/www/certbot -q && docker compose exec -T nginx nginx -s reload ; } >> /var/log/autocheck-cert-renew.log 2>&1 || /opt/autocheck/scripts/notify.sh "🔴 cert-renew завершился с ошибкой — смотри /var/log/autocheck-cert-renew.log"

# Nightly DB backup, 30-day retention (handled inside backup.sh)
0 2 * * * root /opt/autocheck/scripts/backup.sh >> /var/log/autocheck-backup.log 2>&1

# Weekly image/build-cache prune, off-peak Sunday
30 3 * * 0 root /opt/autocheck/scripts/prune.sh >> /var/log/autocheck-prune.log 2>&1

# Health monitoring every 5 minutes (state-diffed Telegram alerts + log)
*/5 * * * * root /opt/autocheck/scripts/monitor.sh >> /var/log/autocheck-monitor.log 2>&1

# Daily "still alive" summary to Telegram (06:00 UTC = 09:00 MSK)
0 6 * * * root /opt/autocheck/scripts/heartbeat.sh >> /var/log/autocheck-monitor.log 2>&1
